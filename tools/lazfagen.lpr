{
  lazfagen - code and resource generator for FontAwesomeIcons.

  Reads metadata/icon-families.json from the Font Awesome Free package
  (npm: @fortawesome/fontawesome-free) and creates:
    - fa_solid_free.inc, fa_regular_free.inc, fa_brands_free.inc
      (enum of icon names + array of Unicode code points + aliases),
    - lazfa_solid_free.res, lazfa_regular_free.res, lazfa_brands_free.res
      (the TTF files as RCDATA resources).

  Usage:
    lazfagen <icon-families.json> <ttf_dir> <output_dir> <fa_version>

  Plain FPC (fpjson + fcl-res) - needs neither LCL nor windres.
}
program lazfagen;

{$mode objfpc}{$H+}

uses
  Classes, SysUtils, fpjson, jsonparser, resource, reswriter;

type
  TStyleDef = record
    FAStyle: String;      // style name in metadata: solid / regular / brands
    TypeName: String;     // TFASolidFree
    Prefix: String;       // fas_ (Font Awesome's own style prefixes: fas / far / fab)
    ConstName: String;    // cFASolidFreeCodes
    IncFile: String;
    TtfFile: String;
    ResFile: String;
    ResName: String;
  end;

const
  STYLES: array[0..2] of TStyleDef = (
    (FAStyle: 'solid';   TypeName: 'TFASolidFree';   Prefix: 'fas_'; ConstName: 'cFASolidFreeCodes';
     IncFile: 'fa_solid_free.inc';   TtfFile: 'lazfa7-free-solid-900.ttf';
     ResFile: 'lazfa_solid_free.res';   ResName: 'LAZFA_SOLID_FREE'),
    (FAStyle: 'regular'; TypeName: 'TFARegularFree'; Prefix: 'far_'; ConstName: 'cFARegularFreeCodes';
     IncFile: 'fa_regular_free.inc'; TtfFile: 'lazfa7-free-regular-400.ttf';
     ResFile: 'lazfa_regular_free.res'; ResName: 'LAZFA_REGULAR_FREE'),
    (FAStyle: 'brands';  TypeName: 'TFABrandsFree';  Prefix: 'fab_'; ConstName: 'cFABrandsFreeCodes';
     IncFile: 'fa_brands_free.inc';  TtfFile: 'lazfa7-brands-regular-400.ttf';
     ResFile: 'lazfa_brands_free.res';  ResName: 'LAZFA_BRANDS_FREE'));

{ Font Awesome icon name -> identifier suffix: '-' becomes '_'.
  'folder-open' -> 'folder_open', '42-group' -> '42_group'.
  With the style prefix in front the result is always a valid identifier
  (names starting with a digit, and reserved words like 'file' or 'repeat'
  are no problem), and the mapping is reversible because Font Awesome names
  consist of [a-z0-9-] only. }
function ToIdent(const AName: String): String;
var
  I: Integer;
begin
  Result := AName;
  for I := 1 to Length(Result) do
    case Result[I] of
      '-': Result[I] := '_';
      'a'..'z', '0'..'9': ;
    else
      raise Exception.CreateFmt('Unexpected character "%s" in icon name "%s"', [Result[I], AName]);
    end;
end;

function IsFreeInStyle(AIcon: TJSONObject; const AStyle: String): Boolean;
var
  Lic: TJSONObject;
  Arr: TJSONArray;
  I: Integer;
  E: TJSONObject;
begin
  Result := False;
  Lic := AIcon.Find('familyStylesByLicense') as TJSONObject;
  if Lic = nil then Exit;
  Arr := Lic.Find('free') as TJSONArray;
  if Arr = nil then Exit;
  for I := 0 to Arr.Count - 1 do
  begin
    E := Arr.Objects[I];
    if (E.Get('family', '') = 'classic') and (E.Get('style', '') = AStyle) then
      Exit(True);
  end;
end;

procedure GenerateStyle(Root: TJSONObject; const S: TStyleDef;
  const AFontDir, AOutDir, AVersion: String);
var
  Names: TStringList;
  Idents: TStringList;     // all identifiers of this style (alias collision check)
  I, J: Integer;
  Icon: TJSONObject;
  Aliases: TJSONArray;
  Al: TJSONObject;
  Code: Cardinal;
  Lines: TStringList;
  Res: TResources;
  R: TGenericResource;
  F: TFileStream;
  AliasLines: TStringList;
  W: TResResourceWriter;
  Id, A: String;
begin
  Names := TStringList.Create;
  Idents := TStringList.Create;
  Lines := TStringList.Create;
  AliasLines := TStringList.Create;
  try
    for I := 0 to Root.Count - 1 do
      if IsFreeInStyle(Root.Items[I] as TJSONObject, S.FAStyle) then
        Names.Add(Root.Names[I]);
    Names.Sort;   // alphabetical - order does not matter for the API (you use names)
    Idents.Sorted := True;
    Idents.Duplicates := dupError;
    for I := 0 to Names.Count - 1 do
      Idents.Add(LowerCase(S.Prefix + ToIdent(Names[I])));   // dupError = guaranteed uniqueness

    Lines.Add('{ Generated by lazfagen from Font Awesome Free ' + AVersion + ' metadata.');
    Lines.Add('  Style: ' + S.FAStyle + ', ' + IntToStr(Names.Count) + ' icons. DO NOT EDIT. }');
    Lines.Add('');
    Lines.Add('type');
    Lines.Add('  ' + S.TypeName + ' = (');
    for I := 0 to Names.Count - 1 do
      if I < Names.Count - 1 then
        Lines.Add('    ' + S.Prefix + ToIdent(Names[I]) + ',')
      else
        Lines.Add('    ' + S.Prefix + ToIdent(Names[I]));
    Lines.Add('  );');
    Lines.Add('');
    Lines.Add('const');
    Lines.Add('  ' + S.ConstName + ': array[' + S.TypeName + '] of Word = (');
    for I := 0 to Names.Count - 1 do
    begin
      Icon := Root.Objects[Names[I]];
      Code := StrToInt('$' + Icon.Get('unicode', ''));
      if Code > $FFFF then
        raise Exception.CreateFmt('%s: code U+%x outside BMP - change Word to Cardinal', [Names[I], Code]);
      Lines.Add(Format('    $%.4X%s // %s', [Code, BoolToStr(I < Names.Count - 1, ',', ' '), Names[I]]));
    end;
    Lines.Add('  );');

    // name aliases from metadata (e.g. cog -> gear) as constants of the same type
    for I := 0 to Names.Count - 1 do
    begin
      Icon := Root.Objects[Names[I]];
      Al := Icon.Find('aliases') as TJSONObject;
      if Al = nil then Continue;
      Aliases := Al.Find('names') as TJSONArray;
      if Aliases = nil then Continue;
      for J := 0 to Aliases.Count - 1 do
      begin
        A := Aliases.Strings[J];
        Id := S.Prefix + ToIdent(A);
        if Idents.IndexOf(LowerCase(Id)) >= 0 then Continue;  // collision - skip
        Idents.Add(LowerCase(Id));
        AliasLines.Add(Format('  %s = %s%s; // %s -> %s', [Id, S.Prefix, ToIdent(Names[I]), A, Names[I]]));
      end;
    end;
    if AliasLines.Count > 0 then
    begin
      Lines.Add('');
      Lines.Add('  { aliases (old/alternative names) }');
      Lines.AddStrings(AliasLines);
    end;
    Lines.SaveToFile(IncludeTrailingPathDelimiter(AOutDir) + S.IncFile);
    WriteLn(Format('%-8s %5d icons, %4d aliases -> %s', [S.FAStyle, Names.Count, AliasLines.Count, S.IncFile]));

    // TTF -> RCDATA resource
    Res := TResources.Create;
    W := TResResourceWriter.Create;
    F := TFileStream.Create(IncludeTrailingPathDelimiter(AFontDir) + S.TtfFile, fmOpenRead or fmShareDenyWrite);
    try
      R := TGenericResource.Create(TResourceDesc.Create(RT_RCDATA), TResourceDesc.Create(S.ResName));
      R.RawData.CopyFrom(F, 0);
      Res.Add(R);
      Res.WriteToFile(IncludeTrailingPathDelimiter(AOutDir) + S.ResFile, W);
      WriteLn(Format('         %s (%d bytes) -> %s', [S.TtfFile, F.Size, S.ResFile]));
    finally
      F.Free;
      W.Free;
      Res.Free;
    end;
  finally
    AliasLines.Free;
    Lines.Free;
    Idents.Free;
    Names.Free;
  end;
end;

var
  J: TJSONData;
  F: TFileStream;
  S: TStyleDef;
begin
  if ParamCount < 4 then
  begin
    WriteLn('Usage: lazfagen <icon-families.json> <ttf_dir> <out_dir> <fa_version>');
    Halt(1);
  end;
  F := TFileStream.Create(ParamStr(1), fmOpenRead or fmShareDenyWrite);
  try
    J := GetJSON(F);
  finally
    F.Free;
  end;
  try
    for S in STYLES do
      GenerateStyle(J as TJSONObject, S, ParamStr(2), ParamStr(3), ParamStr(4));
  finally
    J.Free;
  end;
end.
